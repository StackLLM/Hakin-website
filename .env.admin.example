# Copier en .env.admin, À LA RACINE du projet (pas dans web/ : ce dossier est servi par Vite). Jamais dans Git.
# Lu par npm run admin:sql, sante:sql, sauvegarde et sauvegarde:tester (après web/.env, qu'il complète).

# Administration — SANS préfixe VITE_ : ces lignes restent sur votre ordinateur, jamais dans le site.
# `npm run admin:sql` en fait le SQL à coller dans Supabase : il crée le compte admin ; mot de passe et clé n'en sortent qu'en empreinte.
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=
ADMIN_CLE=

# Robot de surveillance : même valeur que le secret GitHub SANTE_JETON (empreinte posée en base par `npm run sante:sql`).
SANTE_JETON=
